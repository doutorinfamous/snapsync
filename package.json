{
  "name": "snapmaker-timelapse-syncer",
  "private": true,
  "version": "0.1.0",
  "description": "Automatically sync Snapmaker U1 timelapses to Windows and macOS",
  "author": "Papai Nerd",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/doutorinfamous/snapsync",
  "repository": {
    "type": "git",
    "url": "https://github.com/doutorinfamous/snapsync.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
